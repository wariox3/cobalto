# ── Objetivo ───────────────────────────────────────────
# API de torio a probar. Desde el droplet se le pega directo al origen: la IP de jardin
# va en /etc/hosts con este nombre (ver README), así no se pasa por Cloudflare.
CARGA_HOST=https://reddocapi.uk

# ── Usuarios de carga (usuarios.py y escenarios) ───────
# Todos usan esta clave. Los correos son usuario-0001@carga.test … usuario-NNNN@carga.test.
CARGA_CLAVE=
CARGA_USUARIOS=50

# Token de Turnstile. El ambiente de pruebas usa la clave de prueba de Cloudflare, que
# solo acepta este token de prueba.
TURNSTILE_TOKEN=XXXX.DUMMY.TOKEN.XXXX

# ── Base de datos del ambiente de pruebas (solo usuarios.py) ─
# La misma de torio en pruebas. La máquina que corre usuarios.py tiene que estar en los
# trusted sources de la base.
DATABASE_URL=postgresql://<usuario>:<clave>@<host>:<puerto>/<base>?sslmode=require

# ── Valkey del ambiente de pruebas (limpieza del throttling) ─
# Vacío = no se limpia nada y el throttling de torio frena la prueba (5 logins/min por IP).
REDIS_URL=rediss://default:<clave>@<host>:25061/0
# Scopes de DRF cuyos contadores se borran durante la prueba, separados por coma.
THROTTLE_A_LIMPIAR=login
# Cada cuántos segundos se borran. A 0.2 s el límite de 5/min deja pasar hasta ~25 logins/s.
THROTTLE_INTERVALO=0.2
